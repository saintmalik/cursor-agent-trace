# Durable settings for Cursor Agent TRACE (software-observed / signed TRACE).
# Written automatically by: python -m lib install-hooks
# Process environment wins; this file fills missing keys only.
# You should NOT need shell-profile exports for the happy path.
#
# Paths auto-loaded:
#   $CURSOR_PROJECT_DIR/.cursor/agent-trace.env
#   ~/.cursor/agent-trace.env
# Compat: activity-export.env still loaded if agent-trace.env is absent.

# --- Plug-and-play defaults (installer writes these) ---
CURSOR_AGENT_TRACE_REDACT=safe
CURSOR_AGENT_TRACE_SIGN=1
CURSOR_AGENT_TRACE_S3=0

# Tab events (beforeTabFileRead / afterTabFileEdit / model=tab) append to a
# stable tab.jsonl so .cursor/agent-trace/ is not one UUID file per Tab read.
# Full event bodies are kept. Agent UUID trails are unchanged.
# CURSOR_AGENT_TRACE_TAB_MODE=consolidated
# CURSOR_AGENT_TRACE_TAB_MODE=per-event
# Optional daily files: tab-YYYYMMDD.jsonl
# CURSOR_AGENT_TRACE_TAB_ROTATE=daily

# CURSOR_AGENT_TRACE_DIR=~/.cursor/agent-trace

# Model identity comes from Cursor hook payloads (model / model_id). Do not
# pin a static model here — you switch models in the UI constantly. Lab-only
# declared escape hatch (not observed): CURSOR_AGENT_TRACE_MODEL_ID.

# SPIFFE or DID workload identity for the signed record
# CURSOR_AGENT_TRACE_SUBJECT=spiffe://local.cursor/agent/hooks

# Optional: pin signing key (otherwise ephemeral Ed25519; cnf embeds public JWK)
# TRACE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."

# Org collector (recommended for teams) — AWS stays on the server, not the laptop.
# Prefer: python -m lib install-hooks --user --collector-url https://… --collector-token …
# Off unless COLLECTOR_URL is set. Fail-open if collector is down (durable outbox).
# COLLECTOR_URL=https://trace-collector.example.com
# COLLECTOR_TOKEN=org-issued-bearer-token
# COLLECTOR_TIMEOUT=5
#
# Batch + retry (installer writes these defaults — no manual exports needed)
COLLECTOR_BATCH_SIZE=10
COLLECTOR_FLUSH_INTERVAL_SEC=2
COLLECTOR_RETRY_BASE_SEC=1
COLLECTOR_RETRY_MAX_SEC=60
COLLECTOR_RETRY_MAX_ATTEMPTS=0
# Pending buffer + outbox: <project>/.cursor/agent-trace/{pending,outbox}/

# Optional direct S3 — prefer the collector for orgs (no AWS keys on laptop).
# python -m lib install-hooks --user --s3-bucket my-bucket
# CURSOR_AGENT_TRACE_S3=1
# CURSOR_AGENT_TRACE_S3_BUCKET=my-bucket
# CURSOR_AGENT_TRACE_S3_PREFIX=cursor-agent-trace
# CURSOR_AGENT_TRACE_S3_MODE=file
# AWS_REGION=us-east-1

# Power user: keep full bodies in JSONL — python -m lib install-hooks --user --redact full
# CURSOR_AGENT_TRACE_REDACT=full

# CURSOR_AGENT_TRACE_DATA_CLASS=internal
# CURSOR_AGENT_TRACE_POLICY=/path/to/declared-observe.txt
# CURSOR_AGENT_TRACE_APPRAISAL_VERIFIER=https://cursor.com/docs/hooks

# Or point elsewhere:
# CURSOR_AGENT_TRACE_CONFIG=/path/to/custom.env
#
# Allow/deny is NOT an env var — edit agent-trace.policy.json:
#   ~/.cursor/agent-trace.policy.json
#   or $CURSOR_PROJECT_DIR/.cursor/agent-trace.policy.json
# Set "mode": "observe" to log-only, "enforce" to deny on match.
# Optional override path (must be .json):
# CURSOR_AGENT_TRACE_POLICY_JSON=~/.cursor/agent-trace.policy.json
#
# Legacy observational .txt bundle (only if you want TRACE enforcement_mode=declared):
# CURSOR_AGENT_TRACE_POLICY=/path/to/declared-observe.txt
